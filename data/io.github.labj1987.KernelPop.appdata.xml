<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.labj1987.KernelPop</id>
  <name>Kernel Pop</name>
  <summary>Build kernel.org kernels for this machine and install them safely</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <description>
    <p>
      Pick a mainline, stable or longterm release from kernel.org (or drop a
      source tarball onto the window). Kernel Pop checks its signature
      against the kernel.org developers' keys, configures it from the
      running kernel's configuration, builds Debian packages as your own
      user and installs them. The kernel version is read from the source
      and the package metadata rather than parsed from filenames, the
      initramfs is generated and verified to exist before an install
      reports success, and every installed kernel is health-checked so an
      unbootable kernel is visible before a reboot instead of after.
    </p>
  </description>
  <launchable type="desktop-id">kernel-pop.desktop</launchable>
  <url type="homepage">https://github.com/labj1987/kernel-pop</url>
  <developer id="io.github.labj1987">
